# Scout / Relay environment configuration
# Copy to .env.local and fill in what you need. Everything has a safe default.

# --- AI (optional for local demo; without it the deterministic demo path runs) ---
# Model architecture v2.2 (September 2026): Groq free tier for extraction,
# LongCat-2.0 as primary writer, OpenAI as escalation only.
# DeepSeek is disabled by default (SCOUT_DEEPSEEK_ENABLED=0).
#
# Required for full functionality:
#   GROQ_API_KEY — extraction, classification, fallback (key 1)
#   GROQ_API_KEY_2 — second Groq key doubles daily quota (250 → 500/day)
#   LONGCAT_API_KEY — primary writer (drafts, posts, proposals)
#   OPENAI_API_KEY — escalation only when cheaper tiers fail quality gates
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=
GROQ_BASE_URL=https://api.groq.com/openai/v1
SCOUT_TIER0_CHEAP_MODEL=openai/gpt-oss-20b
SCOUT_TIER0_STRONG_MODEL=openai/gpt-oss-120b

# Primary writer — LongCat-2.0 (Meituan MoE, MIT licensed, 1M context)
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

# OpenAI — primary intelligence layer with 3 tiers
# Tier model ids are overridable (set SCOUT_AI_*_MODEL) to track OpenAI's
# lineup as it evolves. Defaults point to the tier's designated model.
OPENAI_API_KEY=
# --- Intelligence tiers (defaults are real OpenAI models; override as needed) ---
SCOUT_AI_LUNA_MODEL=gpt-4o-mini      # FAST: classification, extraction, summarization, labeling
SCOUT_AI_TERRA_MODEL=gpt-4o          # BALANCED: copilot, replies, outreach, studio, proposals
SCOUT_AI_SOL_MODEL=gpt-4.1          # DEEP: ambiguous/high-value reasoning, escalation only
# --- Provider chain (openai leads when its key is present; override to restore old order) ---
# SCOUT_AI_PREFERRED_PROVIDER=openai   # openai|opencode|groq|longcat (default: openai if key set)
# --- Budget governance ---
AI_DAILY_BUDGET=50        # USD — expensive tier blocked beyond this
AI_GPT_DAILY_BUDGET=10    # USD — soft cap on spend-expensive generations

# --- DeepSeek (disabled by default) ---
# Set SCOUT_DEEPSEEK_ENABLED=1 to restore DeepSeek tiers. No production
# workflow depends on DeepSeek when disabled.
SCOUT_DEEPSEEK_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SCOUT_TIER1_MODEL=deepseek-chat
SCOUT_TIER1_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
SCOUT_TIER2_MODEL=deepseek-reasoner
SCOUT_TIER2_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# --- AI behavior flags ---
# Set SCOUT_GENOME_AI=1 to enable AI-assisted genome construction.
# Default is deterministic (no model call).
SCOUT_GENOME_AI=0

# --- Mode ---
# demo: in-memory store, no Supabase needed (default when the Supabase env vars
#       below are absent). supabase: real Postgres + Auth + RLS store.
# SCOUT_DB=demo

# --- Supabase (only needed for supabase mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: only used by the off-peak cron-triggered routes
# (/api/eval/cron-run, /api/few-shot/refresh's GET) and offline scripts/,
# never by a route that serves a browser request. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Off-peak scheduling (vercel.json crons) ---
# Vercel sets this automatically when cron jobs are added via the dashboard;
# set it yourself if configuring outside the dashboard. Required for the
# cron-triggered routes above to accept a request at all — without it they
# refuse every request rather than run unauthenticated.
CRON_SECRET=

# --- Analytics (PostHog) ---
# Get your project API key from https://app.posthog.com/project/settings
# Server-side only — injected into page by layout, not exposed to client bundle.
NEXT_POSTHOG_KEY=
# Host: https://us.i.posthog.com (US), https://eu.i.posthog.com (EU), or self-hosted URL
NEXT_POSTHOG_HOST=https://us.i.posthog.com

# --- Signup ---
# Signup is gated by an invite code. Set this to a random string; anyone
# without it cannot create an organization. Leave blank to disable signup entirely.
SIGNUP_INVITE_CODE=

# --- Email webhook auth ---
# Set this to a random secret; the webhook provider must send it in the
# x-relay-webhook-secret header. Without it the webhook refuses every request.
EMAIL_WEBHOOK_SECRET=

# --- Team rules ---
SCOUT_DAILY_SEND_LIMIT=15

# --- Find Jobs (src/lib/jobs) ---
# Free / no credentials: Himalayas, RemoteOK, Jobicy, Remotive, Arbeitnow.
# Credential-backed sources (leave blank to mark them "Not configured"):
# Adzuna — https://developer.adzuna.com/ (register for app_id + app_key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# The Muse — https://www.themuse.com/developers/api2 (free tier API key)
THE_MUSE_API_KEY=
# USAJOBS — https://developer.usajobs.gov/ (free key) + a descriptive User-Agent
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=


# Scoring program v4 (360° scoring intelligence). Production engine stays v3 until the
# locked-set, shadow and human-label gates pass; candidates run in shadow only.
#   SCORING_ENGINE=v3 | calibrated_v4
#   SCORING_SHADOW_ENGINES=calibrated_v4,ordinal_logit,gbdt_pairwise,knn_features
SCORING_ENGINE=v3
SCORING_SHADOW_ENGINES=
